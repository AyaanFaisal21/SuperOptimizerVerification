# paper contents stay out of version control -- papers/README.md is the
# committed artifact. .txt too: extracted full text is still the paper.
papers/*.pdf
papers/*.txt
__pycache__/
*.py[cod]
.gen/
cache.json
.venv/
venv/

# Raw per-cell results are committed — they are the artifact. The large
# intermediate tensors that produce them are not.
fixtures/*.pt
fixtures/*.npz
results/**/*.npy
*.egg-info/
.ipynb_checkpoints/
.DS_Store
